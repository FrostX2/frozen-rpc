#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
DISTRO_DIR="$DIR/shell/distro"

OS="$(uname -s)"

case "$OS" in
  Darwin)
    exec bash "$DISTRO_DIR/macos.sh"
    ;;
  Linux)
    if [ -f /etc/os-release ]; then
      . /etc/os-release
      case "$ID" in
        arch|manjaro|endeavouros)
          exec bash "$DISTRO_DIR/linux-arch.sh"
          ;;
        debian|ubuntu|linuxmint|pop|elementary|zorin)
          exec bash "$DISTRO_DIR/linux-debian.sh"
          ;;
        fedora|rhel|centos)
          exec bash "$DISTRO_DIR/linux-fedora.sh"
          ;;
        opensuse*|suse)
          exec bash "$DISTRO_DIR/linux-opensuse.sh"
          ;;
        *)
          exec bash "$DISTRO_DIR/linux-generic.sh"
          ;;
      esac
    else
      exec bash "$DISTRO_DIR/linux-generic.sh"
    fi
    ;;
  MINGW*|MSYS*|CYGWIN*)
    exec cmd.exe /c "$DISTRO_DIR/windows.bat"
    ;;
  *)
    echo "Unsupported OS: $OS"
    exit 1
    ;;
esac
